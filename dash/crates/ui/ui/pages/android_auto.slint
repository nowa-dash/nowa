export component AndroidAutoPage inherits Rectangle {
    in-out property <image> android-auto-frame;
    // video size negotiated with the phone; touches are sent in these coordinates
    in property <int> video-width: 800;
    in property <int> video-height: 480;
    // x, y in video pixels; action 0 = down, 1 = up, 2 = move
    callback handle-touch(int, int, int);
    private property <bool> pressed: false;

    background: #000000;
    border-radius: 12px;

    VerticalLayout {
        alignment: center;

        Text {
            text: "Connect your phone to get started";
            color: #ffffff;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    TouchArea {
        property <bool> wc: self.width / self.height <= root.video-width / root.video-height;
        property <length> img-w: self.wc ? self.width : self.height * root.video-width / root.video-height;
        property <length> img-h: self.wc ? self.width * root.video-height / root.video-width : self.height;
        property <length> ox: (self.width - self.img-w) / 2;
        property <length> oy: (self.height - self.img-h) / 2;

        pointer-event(details) => {
            let rx = self.mouse-x - self.ox;
            let ry = self.mouse-y - self.oy;

            if rx >= 0phx && rx < self.img-w && ry >= 0phx && ry < self.img-h {
                if (details.kind == PointerEventKind.down) {
                    root.pressed = true;
                    root.handle-touch(
                        (rx / 1px) * root.video-width / max(1, self.img-w / 1px),
                        (ry / 1px) * root.video-height / max(1, self.img-h / 1px),
                        0);
                } else if (details.kind == PointerEventKind.move) {
                    if (root.pressed) {
                        root.handle-touch(
                            (rx / 1px) * root.video-width / max(1, self.img-w / 1px),
                            (ry / 1px) * root.video-height / max(1, self.img-h / 1px),
                            2);
                    }
                } else if (details.kind == PointerEventKind.up) {
                    root.pressed = false;
                    root.handle-touch(
                        (rx / 1px) * root.video-width / max(1, self.img-w / 1px),
                        (ry / 1px) * root.video-height / max(1, self.img-h / 1px),
                        1);
                }
            } else if (details.kind == PointerEventKind.up || details.kind == PointerEventKind.cancel) {
                root.pressed = false;
            }
        }
        Image {
            source: root.android-auto-frame;
            width: parent.width;
            height: parent.height;
            image-fit: contain;
        }
    }
}
